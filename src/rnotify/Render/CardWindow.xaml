<Window x:Class="rnotify.Render.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="rnotify card" Width="372" Height="124"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual">
    <!-- Имитация акрила: полупрозрачный тёмный фон + бордер + скругление.
         Цвет #28282B — ЗАМЕР нативного баннера (S6.4, measure-banner-color.ps1:
         фон #0C0E0F, bbox 550×142 физ.), альфа F2≈95%. Итеративно доводить глазами. -->
    <Border x:Name="Card" CornerRadius="8" Background="#F228282B"
            BorderBrush="#44FFFFFF" BorderThickness="1" Margin="4"
            MouseLeftButtonDown="OnCardClick" Cursor="Hand">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" X="0" Y="0" />
        </Border.RenderTransform>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Акцент-полоса группы правил (цвет AccentHex вердикта; без цвета — скрыта). -->
            <Border Grid.Column="0" x:Name="AccentStrip" Width="4" CornerRadius="2"
                    Margin="8,10,0,10" Visibility="Collapsed" />
            <!-- Иконка отправителя (S6.3: реестр AppUserModelId/PackageManager);
                 не отрезолвилась — плейсхолдер-колокол. -->
            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="6"
                    Background="#33FFFFFF" Margin="14,0,0,0" VerticalAlignment="Center">
                <Grid>
                    <Image x:Name="SenderIcon" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    <TextBlock x:Name="SenderBadgeText" Text="🔔" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="2" Margin="12,12,8,12" VerticalAlignment="Center">
                <TextBlock x:Name="SenderText" Foreground="#B8FFFFFF" FontSize="11" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" />
                <TextBlock x:Name="BodyText" Foreground="#CCFFFFFF" FontSize="12" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="3" x:Name="CloseButton" Click="OnCloseClick" Width="28" Height="28"
                    Margin="0,6,6,0" VerticalAlignment="Top" HorizontalAlignment="Right"
                    Background="Transparent" BorderThickness="0" Foreground="#AAFFFFFF"
                    Content="✕" FontSize="11" Cursor="Hand" />
        </Grid>
    </Border>
</Window>
