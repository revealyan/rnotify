<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Контракт 22621 — как в ядре: листенер Э2 доступен из коробки. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>rnotify</RootNamespace>
    <!-- PerMonitorV2: зона карточек в DIP на 150% без виртуализации координат. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- MSIX с первого дня (конституция, решение 1): single-project packaging
       через Windows App SDK; self-contained — дев-установка без runtime. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <!-- Подпись — только при наличии дев-сертификата (tools/dev-cert.ps1):
         чистый клон и CI собирают пакет без подписи и остаются зелёными. -->
    <PackageCertificateKeyFile>..\..\certs\rnotify-dev.pfx</PackageCertificateKeyFile>
    <PackageCertificatePassword>rnotify-dev</PackageCertificatePassword>
    <AppxPackageSigningEnabled Condition="Exists('$(PackageCertificateKeyFile)')">true</AppxPackageSigningEnabled>
    <AppxPackageSigningEnabled Condition="!Exists('$(PackageCertificateKeyFile)')">false</AppxPackageSigningEnabled>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <!-- Шум упаковщика при живой подписи через pfx (сертификат на месте,
       подпись наложена — предупреждения не отражают реальность). -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);APPX0105;APPX0107</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\rnotify.Core\rnotify.Core.csproj" />
  </ItemGroup>

  <!-- Иконка трея/окна — ФАЙЛОМ в пакете (PNG-ассеты уезжают в resources.pri,
       а LoadImage для Shell_NotifyIcon читает с диска; трей ждёт
       <BaseDirectory>/Assets/rnotify.ico). -->
  <ItemGroup>
    <Content Include="Assets\rnotify.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
