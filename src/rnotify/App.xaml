<Application x:Class="rnotify.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <!-- OnMainWindowClose: жизнь приложения = жизнь окна-панели; карточки-окна
         не продлевают процесс (детерминизм выхода), второй инстанс зовёт
         Shutdown() до создания окон — режим на него не влияет. -->
    <Application.Resources>
    </Application.Resources>
</Application>
