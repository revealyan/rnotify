<?xml version="1.0" encoding="utf-8"?>
<!-- Идентичность зеркалит docs/store-identity.md (Partner Center) и
     ProductIdentity в rnotify.Core — менять синхронно в трёх местах. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6">

  <Identity Name="revealyan.RNotify"
            Publisher="CN=6F4182DB-0063-4273-87C8-59E15AFFCBCC"
            Version="0.1.0.0" />

  <Properties>
    <DisplayName>RNotify</DisplayName>
    <PublisherDisplayName>revealyan</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- Flexible Virtualization (S5.2/раунд 2): сама по себе capability
         unvirtualizedResources ниже НЕ отключает реестровую виртуализацию —
         нужна эта пара. Без неё ключи формулы Э1 уходят в Helium\User.dat. -->
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ru-RU" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements DisplayName="RNotify"
                          Description="Диспетчер уведомлений Windows 11"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <!-- runFullTrust — стандарт packaged desktop-приложения (стор одобряет
       автоматически); прочие capabilities добавляются только по нужде фич. -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- S5.2/раунд 2: без неё записи HKCU (ключи формулы Э1) уходят в
         виртуальный улей пакета (Helium\User.dat) и не видны WpnService.
         Restricted: для стора потребуется обоснование в сабмишне (S5.3). -->
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

</Package>
