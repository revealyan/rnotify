<Project Sdk="Microsoft.NET.Sdk">

	<!-- Спайк S4.1: WinUI 3-карточка уведомления. Unpackaged self-contained —
	     быстрая петля без установки пакета (fallback по плану: MSIX как у
	     продукта). Одноразовый код — рельсы продукта ослаблены локально. -->
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
		<UseWinUI>true</UseWinUI>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<AssemblyName>rnotify.SpikeWinUI</AssemblyName>
		<RootNamespace>rnotify.SpikeWinUI</RootNamespace>
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<!-- Автоинициализация bootstrap-рантайма при старте (module-init целей
		     WASDK) — вместо Program.Main с Bootstrap.TryInitialize, чья
		     сборка не течёт transitively при CPM. -->
		<WindowsAppSDKBootstrapAutoInitialize>true</WindowsAppSDKBootstrapAutoInitialize>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<Platforms>x64</Platforms>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<!-- Рельсы продукта не для одноразового спайка: -->
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
		<AnalysisLevel>none</AnalysisLevel>
		<EnableMsixTooling>true</EnableMsixTooling>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.WindowsAppSDK" />
	</ItemGroup>

</Project>
