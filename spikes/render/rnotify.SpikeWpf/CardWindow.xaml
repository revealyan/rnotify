<Window x:Class="rnotify.SpikeWpf.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpikeWpf card" Width="364" Height="124"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual">
    <!-- Имитация акрила: полупрозрачный тёмный фон + тонкий бордер + скругление
         (живой системный акрил в WPF недостижим — гипотеза Г2, веб-факты). -->
    <Border x:Name="Card" CornerRadius="8" Background="#E61C1C22"
            BorderBrush="#44FFFFFF" BorderThickness="1" Margin="4"
            MouseLeftButtonDown="OnCardClick" Cursor="Hand">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" X="0" Y="0" />
        </Border.RenderTransform>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                    Background="#33FFFFFF" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="🔔" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,12,8,12" VerticalAlignment="Center">
                <TextBlock Text="Windows PowerShell" Foreground="#B8FFFFFF" FontSize="11" />
                <TextBlock Text="S4.1 spike · WPF" Foreground="White" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" />
                <TextBlock Text="имитация акрила, вход 250 мс" Foreground="#CCFFFFFF" FontSize="12" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2" x:Name="CloseButton" Click="OnCloseClick" Width="28" Height="28"
                    Margin="0,6,6,0" VerticalAlignment="Top" HorizontalAlignment="Right"
                    Background="Transparent" BorderThickness="0" Foreground="#AAFFFFFF"
                    Content="✕" FontSize="11" Cursor="Hand" />
        </Grid>
    </Border>
</Window>
