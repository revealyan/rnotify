<Project Sdk="Microsoft.NET.Sdk">

	<!-- Спайк S4.1: WPF-карточка уведомления. Одноразовый код — рельсы продукта
	     (TreatWarningsAsErrors и пр.) локально ослаблены, см. plan S4.1. -->
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<AssemblyName>rnotify.SpikeWpf</AssemblyName>
		<RootNamespace>rnotify.SpikeWpf</RootNamespace>
		<!-- Рельсы продукта не для одноразового спайка: -->
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
		<AnalysisLevel>none</AnalysisLevel>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

</Project>
