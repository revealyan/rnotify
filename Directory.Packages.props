<Project>

  <!-- Оба флага обязательны: на SDK 10.0.3xx одно лишь ManagePackageReferencesCentrally даёт NU1015. -->
  <PropertyGroup>
    <ManagePackageReferencesCentrally>true</ManagePackageReferencesCentrally>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Прод-зависимости -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <!-- Анализаторы (подключаются в Directory.Build.props) -->
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.0" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.253" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <!-- Тесты -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

</Project>
