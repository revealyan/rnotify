# Стиль репо rnotify. Кураторский минимум в warning (остальное — suggestion):
# EnforceCodeStyleInBuild + TWaE превращает warning в ошибку сборки, поэтому
# повышать severity осознанно, а не пачкой.

root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Код — табы (конвенция revealyan), XML/JSON/YAML — 2 пробела.
[*.cs]
indent_style = tab
indent_size = 4

[*.{csproj,props,targets,xml,json,yml,yaml,manifest}]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# --- C#: включённое в сборку (warning → ошибка при TWaE) ---

[*.cs]
# namespace file-scoped — конвенция репо
csharp_style_namespace_declarations = file_scoped:warning
# this. только при необходимости
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
# var — по вкусу, не закон
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
# модификаторы порядка и доступность
dotnet_style_require_accessibility_modifiers = always:warning
csharp_preferred_modifier_order = public,private,internal,protected,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:suggestion

# --- Именование ---

# Приватные поля — _camelCase
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# Публичные члены — PascalCase
dotnet_naming_rule.public_members_pascal.severity = warning
dotnet_naming_rule.public_members_pascal.symbols = public_members
dotnet_naming_rule.public_members_pascal.style = pascal_case
dotnet_naming_symbols.public_members.applicable_kinds = class, struct, interface, enum, property, method, event
dotnet_naming_symbols.public_members.applicable_accessibilities = public
dotnet_naming_style.pascal_case.capitalization = pascal_case

# Интерфейсы — I-префикс
dotnet_naming_rule.interfaces_i_prefix.severity = warning
dotnet_naming_rule.interfaces_i_prefix.symbols = interfaces
dotnet_naming_rule.interfaces_i_prefix.style = i_prefix
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.i_prefix.required_prefix = I
dotnet_naming_style.i_prefix.capitalization = pascal_case
